[Unit]
Description=mcpo bridge for onedrive-mcp (OpenAPI HTTP wrapper for Open WebUI)
After=network.target

# TEMPLATE — disabled by default. Copy to /etc/systemd/system/, edit the
# paths/User below to match your install, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now onedrive-mcpo.service
#
# SECURITY: mcpo exposes an HTTP endpoint. Bind it to localhost or a private
# interface (as below) unless it's behind an authenticating reverse proxy.

[Service]
Type=simple
User=your-username
WorkingDirectory=/path/to/onedrive-mcp
# Bind to localhost only; use a reverse proxy (with auth) for remote access.
ExecStart=/path/to/onedrive-mcp/venv/bin/mcpo --host 127.0.0.1 --port 8765 -- /path/to/onedrive-mcp/venv/bin/python /path/to/onedrive-mcp/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
