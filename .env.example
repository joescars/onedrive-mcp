# Copy this file to ~/.config/onedrive-mcp/.env (or the directory selected by
# ONEDRIVE_MCP_CONFIG_DIR) and fill in real values. Never commit the real file.

# Application (client) ID from your Azure App Registration
# (Azure Portal -> App registrations -> your app -> Overview -> Application (client) ID)
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Tenant to authenticate against. For personal Microsoft accounts (OneDrive
# consumer, i.e. NOT OneDrive for Business / SharePoint), leave this as
# "consumers". Do not change unless you know you need "common" or a specific
# tenant GUID.
AZURE_TENANT_ID=consumers

# Optional stable data directory override. Defaults to
# $XDG_DATA_HOME/onedrive-mcp or ~/.local/share/onedrive-mcp.
# ONEDRIVE_MCP_DATA_DIR=/absolute/path/onedrive-mcp

# Optional absolute or data-directory-relative path overrides. Defaults to
# $ONEDRIVE_MCP_DATA_DIR/token_cache.bin and $ONEDRIVE_MCP_DATA_DIR/downloads.
# TOKEN_CACHE_PATH=/absolute/path/token_cache.bin
# DOWNLOAD_DIR=/absolute/path/downloads

# Positive byte limits. Transfers are checked before and during streaming.
# Defaults: 100 MiB per file and 1 GiB total under DOWNLOAD_DIR.
MAX_DOWNLOAD_BYTES=104857600
MAX_DOWNLOAD_DIR_BYTES=1073741824
